# -----------------------------------------------------------------------------
# CodeMind — environment variables
# -----------------------------------------------------------------------------
# Copy to `.env` (never commit it) and fill in the values. VITE_* keys are safe
# for the browser bundle; the un-prefixed keys are server-only.
# -----------------------------------------------------------------------------

# Backend (Lovable Cloud / Supabase) — provisioned automatically by Lovable.
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"

# Browser-visible copies (must mirror the server values above).
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Server-only privileged keys — NEVER expose to the browser.
# Managed by Lovable Cloud; do not paste real values into a committed .env.
# SUPABASE_SERVICE_ROLE_KEY="<managed by Lovable Cloud>"
# LOVABLE_API_KEY="<managed by Lovable Cloud>"
